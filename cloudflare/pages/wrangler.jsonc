{
  // ลิงก์สำรอง: https://wormadi.pages.dev (ลิงก์หลักคือ https://wormadi.boboapp2020.workers.dev)
  // หน้าเว็บ/API ส่งต่อไป Worker "walkie" · เสียง (WebSocket) ต่อตรงเข้าห้องวอ (Durable Object ของ walkie)
  "name": "wormadi",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "APP", "service": "wormadi" }],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "WalkieRoom", "script_name": "wormadi" }] }
}
